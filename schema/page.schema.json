{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/the-Arow-H/iSurvive/schema/page.schema.json",
  "title": "iSurvive NA guide page",
  "type": "object",
  "required": ["id", "title", "module", "summary", "sources", "last_reviewed"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "module": {
      "enum": ["shelter", "water", "first-aid", "flora", "fauna", "biomes", "about"]
    },
    "summary": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "biomes": { "type": "array", "items": { "type": "string" } },
    "season": { "type": "string" },
    "review": { "type": "string" },
    "last_reviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  },
  "additionalProperties": true
}
