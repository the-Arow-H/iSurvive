# Local hub
HOST=127.0.0.1
PORT=8080
PUBLIC_BASE_URL=http://127.0.0.1:8080

# Dual compute — Ollama on this machine or on Jarvis
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Kit sales (Stripe Checkout). Leave empty to browse catalog without charging.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Dual host. GitHub remote name: github. Origin remote name: origin.
GITHUB_REMOTE_URL=https://github.com/the-Arow-H/iSurvive.git
ORIGIN_REMOTE_URL=https://origin.cursor.com/unlimitedpracticeguide/iSurvive.git
GITHUB_REMOTE_NAME=github
ORIGIN_REMOTE_NAME=origin
